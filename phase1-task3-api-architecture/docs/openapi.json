
{
  "openapi": "3.0.0",
  "info": {
    "title": "PlaceMux Structured API Architecture",
    "version": "1.0.0",
    "description": "Standardized REST API contract with uniform envelopes, filtering, and pagination."
  },
  "paths": {
    "/api/v1/jobs": {
      "get": {
        "summary": "List jobs with pagination and status filter",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } },
          { "name": "status", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Paginated list of jobs" }
        }
      },
      "post": {
        "summary": "Create a new job posting",
        "responses": {
          "201": { "description": "Job created" },
          "400": { "description": "Validation error" }
        }
      }
    },
    "/api/v1/candidates": {
      "get": {
        "summary": "List candidates with pagination and skill filter",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } },
          { "name": "skill", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Paginated list of candidates" }
        }
      }
    }
  }
}